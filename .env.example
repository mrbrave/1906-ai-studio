# Server-only. Never prefix any secret, budget or service credential with VITE_.
STUDIO_ENABLE_LIVE=false
# Generate a random value of at least 32 characters. Enter it in the private Studio screen.
STUDIO_ACCESS_TOKEN=
# Private lifetime allocation for the ONE Studio User, in USD. No default is allocated.
STUDIO_BUDGET_USD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Match the project's real billing tier. paid uses published standard rates; free uses zero Gemini cost.
GEMINI_BILLING_TIER=paid
